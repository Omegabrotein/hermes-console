<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy auto-backup (Android 6.0..11) rules. Mirrors data_extraction_rules.xml
  for the same reason: keep server list, tokens and voice settings alive.

  - file: Flutter app docs dir + databases (everything Hermes uses).
  - exclude the WAL/SHM journal files of SQLite — they get recreated on launch
    and create restore warnings if copied verbatim while another writer exists.
  - Keystore-backed secrets: same screen-lock caveat as data_extraction_rules.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
    <exclude domain="database" path="HermesDatabase.db-journal" />
    <exclude domain="database" path="HermesDatabase.db-shm" />
</full-backup-content>
